# Copy to .env for local development. Never commit .env.

# REQUIRED, no default: local | test | uat | production.
# Only local and test may use the built-in development JWT key.
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# REQUIRED. The app refuses to start without it. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://slotline:slotline@localhost:5432/slotline
# Seconds to wait when opening a Postgres connection
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_SIZE=10

# Redis is used for rate limiting only; the API stays up without it (plan C12)
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1

# JWT signing keys by key ID (`kid`) as JSON. REQUIRED when ENVIRONMENT is uat or production,
# each key at least 32 bytes (generate with: openssl rand -base64 48).
# Leave unset for local and test: a built-in development key is used.
# Rotate with no downtime: add a new kid, point JWT_ACTIVE_KID at it, deploy, and remove the old
# kid after 15 minutes (the lifetime of an access token signed with it).
# JWT_KEYS={"2026-10":"<secret>"}
# JWT_ACTIVE_KID=2026-10

# IANA zone for new organisations and providers (plan C5)
DEFAULT_TIMEZONE=Asia/Kolkata

# Used by tests/integration/conftest.py (a separate database from the one above)
TEST_DATABASE_URL=postgresql+asyncpg://slotline:slotline@localhost:5432/slotline_test
