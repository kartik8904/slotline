# Copy to .env for local development. Never commit .env.

# local | test | uat | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# REQUIRED. The app refuses to start without it. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://slotline:slotline@localhost:5432/slotline
# Seconds to wait when opening a Postgres connection
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_SIZE=10

# Redis is used for rate limiting only; the API stays up without it (plan C12)
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1

# IANA zone for new organisations and providers (plan C5)
DEFAULT_TIMEZONE=Asia/Kolkata

# Used by tests/integration/conftest.py (a separate database from the one above)
TEST_DATABASE_URL=postgresql+asyncpg://slotline:slotline@localhost:5432/slotline_test
